# Copy to .env.local and fill in. Never commit .env.local.
#
# `npm test` needs none of these. Each key says which part of Tala reads it
# and the ticket that starts using it. test/env-example.test.ts keeps this
# file in step with the spec and fails if a value is ever committed here.

# --- Claude ------------------------------------------------------------------

# First-party Anthropic API only. Prepaid credit with auto-reload off.
# Also saved as a GitHub Actions secret for the eval gate (#9).
ANTHROPIC_API_KEY=

# --- Voice -------------------------------------------------------------------

# Which speech providers the agent uses (#7, #21):
#   local   ElevenLabs. Your own machine only, and the demo video.
#   public  Gemini free tier. The public demo.
TALA_VOICE_PROFILE=

# ElevenLabs free plan, for the `local` profile (#3, #7).
# Never set this on Vercel, LiveKit Cloud or CI: free accounts used from
# cloud servers get flagged.
ELEVENLABS_API_KEY=

# Google AI Studio key for the Gemini API, free tier, for the `public`
# profile (#3, #21). The LiveKit Google plugin reads this name.
GOOGLE_API_KEY=

# --- LiveKit -----------------------------------------------------------------

# Local development uses the LiveKit server in Docker (#7):
#   ws://localhost:7880 with key `devkey` and secret `secret`.
# The public demo uses a LiveKit Cloud project (#23).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database ----------------------------------------------------------------

# Postgres for calls, spans, scores and limits (#18). Neon's pooled
# connection string for the public demo (#23).
DATABASE_URL=

# --- Public demo (#22, #23) --------------------------------------------------

# The passcode visitors type to start a call.
TALA_DEMO_PASSCODE=

# Claude spend caps in USD, enforced by the reserving spend guard.
# The public demo uses 2.00 a day and 20.00 a month.
TALA_DAILY_BUDGET_USD=
TALA_MONTHLY_BUDGET_USD=
